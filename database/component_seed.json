{
  "project": "CircuitVision",
  "seed_version": 1,
  "source": "Team-authored component_details.mjs guide entries and deployed 87-class model map. Entries are educational references, not verified datasheets or measured values.",
  "categories": [
    {
      "slug": "resistor",
      "title": "Resistor",
      "role": "Limits current and sets voltages in electronic circuits.",
      "learn": "Resistance is measured in ohms (Ω). Axial resistors use color bands; SMD resistors may have printed numbers.",
      "value": "Use the 4/5-band calculator or confirm with a multimeter. When the optional Sam specialist model is installed, YOLO may suggest 2K, 10K or 52K visually; this is not an electrical measurement and must be verified."
    },
    {
      "slug": "led",
      "title": "LED",
      "role": "Emits light when forward biased with the correct current.",
      "learn": "Polarity matters. Use a current-limiting resistor; typical forward voltage depends on color and part.",
      "value": "LED voltage and current rating cannot be identified reliably from appearance alone."
    },
    {
      "slug": "diode",
      "title": "Diode",
      "role": "Allows current mainly in one direction; used for rectification and protection.",
      "learn": "Check the cathode stripe and datasheet. Use diode-test mode to measure forward drop.",
      "value": "Exact type, voltage and current ratings require markings or a part number."
    },
    {
      "slug": "capacitor",
      "title": "Capacitor",
      "role": "Stores electric charge; used for filtering, timing and decoupling.",
      "learn": "Capacitance is measured in farads (often µF, nF or pF); electrolytic types can be polarized.",
      "value": "Read printed capacitance and voltage ratings or measure with an LCR meter."
    },
    {
      "slug": "ldr",
      "title": "LDR / photoresistor",
      "role": "Changes resistance as surrounding light changes.",
      "learn": "Typical resistance is lower in bright light and higher in darkness.",
      "value": "No fixed resistance value; measure in the current lighting conditions."
    },
    {
      "slug": "breadboard",
      "title": "Breadboard",
      "role": "Allows temporary solderless prototyping of circuits.",
      "learn": "Power rails may be split. Check internal connection groups and voltage limits.",
      "value": "There is no electrical component value to decode."
    },
    {
      "slug": "potentiometer",
      "title": "Potentiometer",
      "role": "Variable resistor used for adjustment or voltage division.",
      "learn": "The wiper moves along the resistive track between end terminals.",
      "value": "Measure outer-pin resistance or read the printed resistance marking."
    },
    {
      "slug": "transistor",
      "title": "Transistor",
      "role": "Amplifies or switches electronic signals.",
      "learn": "Pinout and switching limits differ by part and package.",
      "value": "Exact part number and ratings must come from a marking or datasheet."
    },
    {
      "slug": "ic",
      "title": "Integrated circuit / logic IC",
      "role": "Combines many electronic functions in one package.",
      "learn": "74HC-series logic chips can look alike; the printed part number determines the logic function.",
      "value": "OCR of the chip marking or manual part entry is needed to identify the precise IC."
    },
    {
      "slug": "arduino",
      "title": "Arduino board",
      "role": "Programmable microcontroller development board.",
      "learn": "Useful for sensor reading, embedded logic, digital and analog I/O.",
      "value": "Voltage/current limits depend on the exact board variant and pins; check its datasheet."
    },
    {
      "slug": "battery",
      "title": "Battery",
      "role": "Portable DC power source.",
      "learn": "Voltage depends on chemistry, cell count and state of charge.",
      "value": "Read the label and verify with a multimeter; appearance does not measure actual voltage."
    },
    {
      "slug": "power",
      "title": "Power module",
      "role": "Regulates or distributes DC electrical power.",
      "learn": "A breadboard power module can output multiple voltages and must be connected correctly.",
      "value": "Read the regulator label and selected jumpers; confirm the actual output with a multimeter."
    },
    {
      "slug": "sensor",
      "title": "Sensor module",
      "role": "Converts a physical measurement into an electrical signal.",
      "learn": "Common examples include ultrasonic, IR, temperature and motion sensors.",
      "value": "Range, supply voltage and calibration depend on the exact part number."
    },
    {
      "slug": "display",
      "title": "Display / indicator",
      "role": "Presents readings, digits or status to a user.",
      "learn": "Can use LED segments, character LCDs, LED matrices or OLED panels.",
      "value": "Resolution, pinout and required voltage vary by module."
    },
    {
      "slug": "instrument",
      "title": "Lab instrument",
      "role": "Measures or generates electronic signals in a workbench lab.",
      "learn": "Examples include multimeters, oscilloscopes and function generators.",
      "value": "Read the instrument display and use the correct probes and measurement range."
    },
    {
      "slug": "general",
      "title": "General component",
      "role": "Laboratory/electronic object category in the detection model.",
      "learn": "Check the printed part number, pinout and manufacturer documentation before use.",
      "value": "The system does not automatically determine an electrical value. Verify with part markings or suitable measurement equipment."
    }
  ],
